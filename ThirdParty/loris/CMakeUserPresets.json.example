{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Debug (project .venv)",
            "description": "Copy this file to CMakeUserPresets.json (gitignored) and edit to taste. Personal layout belongs here rather than in CMakePresets.json, so that a clone builds against whatever Python its owner prefers. Debug build against ${sourceDir}/.venv, with Homebrew's arm64 prefix ahead of PATH for SWIG and FFTW.",
            "inherits": "ci",
            "binaryDir": "${sourceDir}/build",
            "environment": {
                "VIRTUAL_ENV": "${sourceDir}/.venv",
                "PATH": "${sourceDir}/.venv/bin:/opt/homebrew/bin:$penv{PATH}"
            }
        },
        {
            "name": "release",
            "displayName": "Release (project .venv)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "nofftw",
            "displayName": "Debug, bundled FFT (project .venv)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-nofftw",
            "cacheVariables": {
                "LORIS_FFTW": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "jobs": 8
        },
        {
            "name": "release",
            "configurePreset": "release",
            "jobs": 8
        },
        {
            "name": "nofftw",
            "configurePreset": "nofftw",
            "jobs": 8
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8
            }
        },
        {
            "name": "nofftw",
            "configurePreset": "nofftw",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "jobs": 8
            }
        }
    ]
}
